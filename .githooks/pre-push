#!/bin/sh
#
# pre-push hook: ローカルCIを実行してから push
#
# このフックは push 前に自動実行され、CI が失敗した場合は push を中断します。
# インストール方法: python3 scripts/install_hooks.py

echo ""
echo "=========================================="
echo "pre-push: Running local CI"
echo "=========================================="
echo ""

# Python の検出（python または python3）
# Windows (Git Bash) では python を優先
PYTHON_CMD=""
if command -v python >/dev/null 2>&1; then
    PYTHON_CMD="python"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON_CMD="python3"
else
    echo "python not found" >&2
    echo "Please install Python 3.7+" >&2
    exit 1
fi

echo "Using Python: $PYTHON_CMD"

# ci_local.py を実行
# UTF-8 encoding for Windows
export PYTHONIOENCODING=utf-8
"$PYTHON_CMD" scripts/ci_local.py

# CI の結果で push の可否を判定
if [ $? -ne 0 ]; then
    echo "" >&2
    echo "=========================================="  >&2
    echo "CI failed - aborting push" >&2
    echo "=========================================="  >&2
    echo "" >&2
    echo "Please fix the errors and try again." >&2
    echo "Log: reports/.ci_logs/latest.log" >&2
    echo "" >&2
    exit 1
fi

echo ""
echo "=========================================="
echo "CI passed - continuing push"
echo "=========================================="
echo ""

exit 0

